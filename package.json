{
  "name": "moshift",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server/dev.ts",
    "build": "bun run build:client && bun run build:ssr",
    "build:client": "bun build ./src/entry-client.tsx --outdir ./dist/client --target browser --minify",
    "build:ssr": "bun build ./server/entry-server.tsx --outdir ./dist/server --target bun --minify",
    "start": "bun run server/prod.ts",
    "preview": "bun run build && bun run start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2"
  }
}
