# Agnes AI（国内站，OpenAI 兼容，免费额度）
AGNES_API_KEY=sk-your-agnes-key
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_MODEL=agnes-2.5-flash
# 思考强度：不设（模型默认思考，实测稳定）；如需调节可设 high/medium/low（注意：high 思考量无上界，
# 会间歇性吃光预算导致空输出/超时，需配合极大 max_tokens 兜底；各调用点 max_tokens 已统一 60000 兜底）
# AGNES_REASONING_EFFORT=high

# 文本模型切换（可选）：配置 TEXT_* 后，中枢/写手/审查/记账等全部文本任务改用该端点；
# 不配置则回落 AGNES_*。端点须为 OpenAI 兼容（chat/completions + SSE），
# Responses API 仅 Agnes 端点启用，其他端点自动走 chat/completions。
# 示例（基元）：
# TEXT_BASE_URL=https://tokenrhythm.studio/v1
# TEXT_API_KEY=sk_tr_your-tokenrhythm-key
# TEXT_MODEL=deepseek-v4-flash-0731
# 注意：插画/视频固定读 AGNES_BASE_URL/AGNES_API_KEY，不受 TEXT_* 影响。

# 全局速率/并发限流（企业认证默认值 = 实际 RPM；限流器排队，不主动触发 429）
# 文本模型 agnes-2.5-flash：默认 5 并发 / 40 RPM（企业实际 40）
# AGNES_TEXT_CONCURRENCY=5
# AGNES_TEXT_RPM=40
# 图片模型 agnes-image-2.5-flash（1K 档）：默认 5 并发 / 40 RPM（企业实际 40）
# AGNES_IMAGE_CONCURRENCY=5
# AGNES_IMAGE_RPM=40
# 视频模型 agnes-video-2.5-flash：默认 1 并发 / 2 RPM（企业实际 2）
# AGNES_VIDEO_CONCURRENCY=1
# AGNES_VIDEO_RPM=2

# Agnes 生图（同一 key 与 BASE_URL，当前免费 $0/张）
# 硬性约束（代码层固化，不可配置）：模型 agnes-image-2.5-flash、尺寸严格 1K 档位

# Agnes 视频生成（同一 key 与 BASE_URL，异步任务 API，当前免费 $0/秒）
# 硬性约束（代码层固化，不可配置）：模型 agnes-video-2.5-flash、720p 16:9、时长 5~15 秒、24fps

# AnySearch（JSON-RPC，可选但推荐）
ANYSEARCH_API_KEY=as_sk_your-anysearch-key
