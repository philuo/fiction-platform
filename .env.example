# Agnes AI（国内站，OpenAI 兼容，免费额度）
AGNES_API_KEY=sk-your-agnes-key
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_FALLBACK_MODEL=agnes-2.0-flash

# Agnes 生图（同一 key 与 BASE_URL，当前免费 $0/张）
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
IMAGE_PROVIDER=agnes        # agnes（云端，默认）| mflux（本地，失败自动回退）
IMAGE_STEPS=8               # 仅 mflux 回退时生效
IMAGE_QUANT=8

# Agnes 视频生成（同一 key 与 BASE_URL，异步任务 API，当前免费 $0/秒）
AGNES_VIDEO_MODEL=agnes-video-v2.0
VIDEO_NUM_FRAMES=121        # 帧数：须满足 8n+1 且 ≤441（121≈5秒 @24fps）
VIDEO_FRAME_RATE=24         # 帧率：时长 = num_frames / frame_rate

# AnySearch（JSON-RPC，可选但推荐）
ANYSEARCH_API_KEY=as_sk_your-anysearch-key
